{
  "name": "context-diet",
  "version": "0.1.0",
  "description": "Smart Context Engineering Gateway, Lossless Tool Output Compressor & Episodic Memory Folder for AI Agents (Proxy + MCP + Dashboard)",
  "type": "module",
  "bin": {
    "context-diet": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts serve",
    "mcp": "node --experimental-strip-types src/cli.ts mcp",
    "bench": "node --experimental-strip-types src/cli.ts benchmark",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "context-engineering",
    "token-compression",
    "mcp-server",
    "episodic-memory",
    "llm-proxy",
    "claude-code",
    "opencode",
    "cursor"
  ],
