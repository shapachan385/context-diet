{
  "name": "context-diet",
  "version": "0.2.0",
  "description": "Streaming OpenAI/Anthropic Context Compression Proxy, Cross-Process SQLite Vault & MCP Server for Coding Agents",
  "type": "module",
  "bin": {
    "context-diet": "./bin/context-diet.mjs"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs",
    "SECURITY.md",
    "start-dashboard.bat"
  ],
  "scripts": {
    "start": "node --no-warnings --experimental-strip-types src/cli.ts serve",
    "mcp": "node --no-warnings --experimental-strip-types src/cli.ts mcp",
    "bench": "node --no-warnings --experimental-strip-types src/cli.ts benchmark",
    "demo:e2e": "node --no-warnings --experimental-strip-types examples/e2e-agent-workflow.ts",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts"
  },
  "keywords": [
    "ai-agent",
    "context-engineering",
    "token-compression",
    "mcp-server",
    "episodic-memory",
    "llm-proxy",
    "codex-cli",
    "claude-code",
    "opencode",
    "cursor"
  ],
  "author": "ContextDiet Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shapachan385/context-diet.git"
  },
  "bugs": {
    "url": "https://github.com/shapachan385/context-diet/issues"
  },
  "homepage": "https://github.com/shapachan385/context-diet#readme",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
