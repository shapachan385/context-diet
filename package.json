  "repository": {
    "type": "git",
    "url": "git+https://github.com/shapachan385/context-diet.git"
  },
  "bugs": {
    "url": "https://github.com/shapachan385/context-diet/issues"
  },
  "homepage": "https://github.com/shapachan385/context-diet#readme",
  "engines": {
    "node": ">=22.6.0"
  }
}
